{
  "name": "pwnfox",
  "private": true,
  "description": "Build tooling for the PwnFox browser extension",
  "scripts": {
    "build:firefox": "web-ext build --source-dir firefox --artifacts-dir web-ext-artifacts --overwrite-dest --no-input",
    "lint:firefox": "web-ext lint --source-dir firefox --no-input",
    "sign:firefox": "web-ext sign --source-dir firefox --artifacts-dir web-ext-artifacts --channel unlisted --approval-timeout 900000 --no-input",
    "test:firefox": "node --test tests/firefox/*.test.js"
  },
  "devDependencies": {
    "web-ext": "10.6.0"
  }
}
