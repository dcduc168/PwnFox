{
  "description": "Pwnfox",
  "manifest_version": 2,
  "name": "PwnFox",
  "version": "1.0.8",
  "icons": {
    "48": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pwnfox@dcduc168.github.io",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "webRequest",
    "contextualIdentities",
    "cookies",
    "proxy",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "options_ui": {
    "page": "src/settings/index.html",
    "browser_style": false
  },
  "browser_action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg"
    },
    "default_title": "PwnFox",
    "browser_style": false
  },
  "background": {
    "scripts": [
      "src/config.js",
      "src/colors.js",
      "src/features.js",
      "src/background.js"
    ]
  },
  "devtools_page": "src/devtools/index.html"
}
